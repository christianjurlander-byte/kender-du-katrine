# Kopiér denne fil til ".env.local" og udfyld værdierne.
# Se README.md for en trin-for-trin guide til hvor du finder dem i Supabase.

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API > Project API keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > Project API keys > service_role (HEMMELIG! Del den aldrig, og sæt den ALDRIG med NEXT_PUBLIC_ foran)
SUPABASE_SERVICE_ROLE_KEY=

# Valgfrit — kun nødvendigt for AI-genererede sjove beskeder i lobbyen.
# Uden denne bruges automatisk nogle faste, sjove beskeder i stedet.
# Opret på console.anthropic.com > API Keys. Se README.md for guide.
ANTHROPIC_API_KEY=
